require('dotenv').config();
const express = require('express');
const nodemailer = require('nodemailer');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json());

// إعداد ناقل البريد (SMTP) لحساب Hotmail / Outlook
const transporter = nodemailer.createTransport({
  host: 'smtp-mail.outlook.com',
  port: 587,
  secure: false,
  auth: {
    user: process.env.HOTMAIL_USER,
    pass: process.env.HOTMAIL_PASS,
  },
  tls: {
    ciphers: 'SSLv3',
  },
});

// مسار اختبار للتأكد من أن الخادم يعمل على Vercel
app.get('/api/health', (req, res) => {
  res.status(200).json({
    success: true,
    message: 'خادم متجر اللحوم الطازجة يعمل بنجاح على Vercel',
  });
});

// 1. الموافقة المبدئية على دفعة Pi من الخادم
app.post('/api/pi/approve', async (req, res) => {
  const { paymentId } = req.body;
  if (!paymentId || !process.env.PI_API_KEY) {
    return res.status(400).json({
      success: false,
      message: 'paymentId أو PI_API_KEY مفقود.',
    });
  }

  try {
    const response = await fetch(`https://api.minepi.com/v2/payments/${paymentId}/approve`, {
      method: 'POST',
      headers: {
        Authorization: `Key ${process.env.PI_API_KEY}`,
        'Content-Type': 'application/json',
      },
    });
    const data = await response.json();
    return res.status(response.status).json({ success: response.ok, data });
  } catch (err) {
    return res.status(500).json({ success: false, message: err.message });
  }
});

// 2. إكمال دفعة Pi بعد تأكيد المعاملة على الشبكة
app.post('/api/pi/complete', async (req, res) => {
  const { paymentId, txid } = req.body;
  if (!paymentId || !txid || !process.env.PI_API_KEY) {
    return res.status(400).json({
      success: false,
      message: 'paymentId أو txid أو PI_API_KEY مفقود.',
    });
  }

  try {
    const response = await fetch(`https://api.minepi.com/v2/payments/${paymentId}/complete`, {
      method: 'POST',
      headers: {
        Authorization: `Key ${process.env.PI_API_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ txid }),
    });
    const data = await response.json();
    return res.status(response.status).json({ success: response.ok, data });
  } catch (err) {
    return res.status(500).json({ success: false, message: err.message });
  }
});

// 3. إرسال إشعار الطلب عبر Hotmail
app.post('/api/orders/notify-hotmail', async (req, res) => {
  const { orderId, customerName, customerEmail, items, totalPi, paymentTxid } = req.body;

  if (!orderId || !items || !Array.isArray(items) || items.length === 0) {
    return res.status(400).json({
      success: false,
      message: 'بيانات الطلب غير مكتملة.',
    });
  }

  const itemsListHtml = items
    .map(
      (item) =>
        `<li><strong>${item.name}</strong> — الكمية: ${item.quantity} — السعر: ${item.price} Pi</li>`
    )
    .join('');

  const htmlBody = `
    <div dir="rtl" style="font-family: Arial, sans-serif; line-height: 1.7; color: #222;">
      <h2 style="color: #8b1e1e;">🥩 إشعار طلب لحوم طازجة جديد #${orderId}</h2>
      <p><strong>اسم العميل:</strong> ${customerName || 'عميل Pi Network'}</p>
      <p><strong>بريد العميل:</strong> ${customerEmail || 'غير مزود'}</p>
      <p><strong>الإجمالي:</strong> ${totalPi ?? 'غير محدد'} Pi</p>
      <p><strong>رقم معاملة الدفع (TXID):</strong> ${paymentTxid || 'قيد التأكيد'}</p>
      <h3>تفاصيل الطلب:</h3>
      <ul>${itemsListHtml}</ul>
    </div>
  `;

  try {
    const ownerMail = await transporter.sendMail({
      from: `"متجر اللحوم الطازجة" <${process.env.HOTMAIL_USER}>`,
      to: process.env.STORE_OWNER_EMAIL || process.env.HOTMAIL_USER,
      subject: `طلب جديد #${orderId} - ${customerName || 'عميل'}`,
      html: htmlBody,
    });

    let customerMailId = null;
    if (customerEmail && customerEmail.includes('@')) {
      const customerMail = await transporter.sendMail({
        from: `"متجر اللحوم الطازجة" <${process.env.HOTMAIL_USER}>`,
        to: customerEmail,
        subject: `تأكيد استلام طلبك #${orderId}`,
        html: htmlBody,
      });
      customerMailId = customerMail.messageId;
    }

    return res.status(200).json({
      success: true,
      message: 'تم إرسال إشعار الطلب عبر Hotmail بنجاح.',
      ownerMessageId: ownerMail.messageId,
      customerMessageId: customerMailId,
    });
  } catch (error) {
    console.error('❌ خطأ أثناء إرسال البريد عبر Hotmail:', error);
    return res.status(500).json({
      success: false,
      message: 'تعذر إرسال البريد عبر Hotmail.',
      error: error.message,
    });
  }
});

// تصدير التطبيق للعمل كـ Serverless Function على Vercel
module.exports = app;

// التشغيل المحلي فقط عند التجربة على جهازك
if (process.env.NODE_ENV !== 'production') {
  const PORT = process.env.PORT || 3000;
  app.listen(PORT, () => {
    console.log(`🚀 الخادم يعمل محلياً على http://localhost:${PORT}`);
  });
}
